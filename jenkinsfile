pipeline {
    agent any

    parameters {
        string(name: 'JAVA_HOME_PATH', defaultValue: '/opt/jdk-21',
               description: 'Java para iniciar o Gradle; o JDK 25 do Paper é obtido automaticamente.')
    }

    environment {
        JAVA_HOME = "${params.JAVA_HOME_PATH}"
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}"
        MINECRAFT_PLUGIN_DIR = '/hg-server'
        PLUGIN_JAR = 'hardcoregames-1.0.0-all.jar'
    }

    options { disableConcurrentBuilds() }

    stages {
        stage('Compile') {
            steps {
                dir('hardcoregames') {
                    sh '''
                        set -eu
                        java -version
                        chmod +x ./gradlew
                        ./gradlew --no-daemon clean classes testClasses
                    '''
                }
            }
        }

        stage('Tests') {
            steps {
                dir('hardcoregames') {
                    sh './gradlew --no-daemon test'
                }
            }
            post {
                always {
                    junit testResults: 'hardcoregames/build/test-results/test/TEST-*.xml', allowEmptyResults: false
                    archiveArtifacts artifacts: 'hardcoregames/build/reports/tests/test/**', allowEmptyArchive: true
                }
            }
        }

        stage('Package Validation') {
            steps {
                dir('hardcoregames') {
                    sh '''
                        set -eu
                        ./gradlew --no-daemon shadowJar
                        jar tf "build/libs/$PLUGIN_JAR" > build/jar-contents.txt
                        grep -q '^plugin.yml$' build/jar-contents.txt
                        grep -q '^br/dev/sno0s/hgplugin/libs/sqlite/JDBC.class$' build/jar-contents.txt
                        sha256sum "build/libs/$PLUGIN_JAR"
                    '''
                }
                archiveArtifacts artifacts: "hardcoregames/build/libs/${env.PLUGIN_JAR},hardcoregames/build/libs/openhg-blockhit-26.2.zip", fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu
                    test -d "$MINECRAFT_PLUGIN_DIR"
                    cp "hardcoregames/build/libs/$PLUGIN_JAR" "$MINECRAFT_PLUGIN_DIR/$PLUGIN_JAR.tmp"
                    mv -f "$MINECRAFT_PLUGIN_DIR/$PLUGIN_JAR.tmp" "$MINECRAFT_PLUGIN_DIR/$PLUGIN_JAR"
                    # Remove apenas o artefato antigo sem SQLite, evitando dois plugins iguais.
                    rm -f "$MINECRAFT_PLUGIN_DIR/hardcoregames-1.0.0.jar"
                    cmp "hardcoregames/build/libs/$PLUGIN_JAR" "$MINECRAFT_PLUGIN_DIR/$PLUGIN_JAR"
                '''
            }
        }
    }

    post {
        always {
            emailext(
                subject: "Pipeline '${env.JOB_NAME} #${env.BUILD_NUMBER}' finalizada: ${currentBuild.currentResult}",
                body: """Projeto: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Resultado: ${currentBuild.currentResult}
Testes e detalhes: ${env.BUILD_URL}
O deploy ocorre somente após compilação, testes e validação do JAR concluídos.
""",
                to: 'maathdesigner@outlook.com'
            )
        }
        success { echo 'Testes, empacotamento e deploy concluídos.' }
        failure { echo 'Pipeline falhou. Consulte os testes e logs antes de fazer deploy.' }
    }
}
